434\u0440\u0430\u0432\u0435\u043d \u043e\u0434 \u0414\u0435\u043a\u0430\u043d\u043e\u0442 \u043d\u0430 \u0424\u0418\u041d\u041a\u0418 \u043f\u0440\u043e\u0444. \u041f\u0435\u0442\u0440\u0435 \u041b\u0430\u043c\u0435\u0441\u043a\u0438, \u0430 \u043f\u043b\u0430\u043d\u043e\u0442 \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430 \u0431\u0435\u0448\u0435 \u043f\u0440\u0435\u0442\u0441\u0442\u0430\u0432\u0435\u043d \u043e\u0434 \u0440\u0430\u043a\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u043e\u0442 \u043d\u0430 \u0424\u041e\u041a\u0423\u0421 \u041b\u0430\u0431 - \u043f\u0440\u043e\u0444. \u0410\u043d\u0430 \u041c\u0430\u0434\u0435\u0432\u0441\u043a\u0430 \u0411\u043e\u0433\u0434\u0430\u043d\u043e\u0432\u0430, \u043f\u0440\u0435\u0442\u0441\u0435\u0434\u0430\u0442\u0435\u043b\u043e\u0442 \u043d\u0430 \u0424\u0421\u0421 \u0424\u0438\u043d\u043a\u0438 - \u0413\u0435\u043e\u0440\u0433\u0438\u043d\u0430 \u0418\u043b\u0438\u0435\u0432\u0441\u043a\u0430 \u0438 \u0438\u043d\u0436. \u0421\u0442\u0435\u0444\u0430\u043d\u0438\u0458\u0430 \u0424\u0438\u043b\u0438\u043f\u0430\u0448\u0438\u045c, \u0430\u0432\u0442\u043e\u0440\u043a\u0430 \u043d\u0430 \u0430\u043f\u043b\u0438\u043a\u0430\u0446\u0438\u0458\u0430\u0442\u0430 \u0437\u0430 \u043f\u043e\u043b\u0435\u0441\u043d\u043e \u0444\u043e\u043a\u0443\u0441\u0438\u0440\u0430\u045a\u0435 \u043f\u0440\u0438 \u0443\u0447\u0435\u045a\u0435\u0442\u043e, FocusMe. \u041f\u043e\u0441\u043b\u0435 \u043e\u0444\u0438\u0446\u0438\u0458\u0430\u043b\u043d\u0438\u043e\u0442 \u0434\u0435\u043b, \u0441\u0435 \u043e\u0434\u0440\u0436\u0430 \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u043d\u0430 \u0441\u0440\u0435\u0434\u0431\u0430.\u00a0\u003C\/span\u003E\u003C\/p\u003E\n\u003Cp class=\u0022x_MsoNormal\u0022 style=\u0022color: rgb(0, 0, 0); font-family: \u0026quot;Segoe UI\u0026quot;, \u0026quot;Segoe UI Web (West European)\u0026quot;, -apple-system, BlinkMacSystemFont, Roboto, \u0026quot;Helvetica Neue\u0026quot;, sans-serif; font-size: 1